{
    "name": "yireo/magento2-disablelog2",
    "license": "OSL-3.0",
    "type": "magento2-module",
    "homepage": "https://github.com/yireo/Yireo_DisableLog2",
    "description": "Magento 2 module to disable customer logging",
    "keywords": [
        "composer-installer",
        "magento"
    ],
    "version": "0.1.0",
    "require": {
        "magento/framework": "^102.0|^103.0",
        "magento/module-backend": "^101.0|^102.0",
        "magento/module-config": "^101.0|^102.0",
        "magento/module-customer": "^100.1|^101.0|^102.0|^103.0",
        "magento/module-store": "^101.0|^102.0",
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yireo/magento2-integration-test-helper": "~0.0"
    },
    "autoload": {
        "psr-4": {
            "Yireo\\DisableLog2\\": ""
        },
        "files": [
            "registration.php"
        ]
    }
}